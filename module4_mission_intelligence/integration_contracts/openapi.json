            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "total_anomalies_detected": {
            "type": "integer",
            "title": "Total Anomalies Detected",
            "default": 0
          },
          "highest_severity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DeviationSeverity"
