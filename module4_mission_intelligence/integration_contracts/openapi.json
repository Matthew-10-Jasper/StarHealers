              {
                "$ref": "#/components/schemas/GravityEnvironment"
              },
              {
                "type": "null"
              }
            ]
          },
          "gravity_value_g": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gravity Value G"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence"
          },
          "operator_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator Id",
            "default": "MISSION_CONTROLLER"
          }
        },
        "type": "object",
        "required": [
          "reason"
        ],
        "title": "ContextUpdateRequest"
      },
      "DataQualityContext": {
        "properties": {
          "overall_status": {
            "$ref": "#/components/schemas/QualityStatus",
            "default": "UNKNOWN"
          },
          "unknown_parameters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unknown Parameters"
          },
          "stale_parameters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Stale Parameters"
          },
          "contradictory_parameters": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contradictory Parameters"
          },
          "last_telemetry_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Telemetry Timestamp"
          }
        },
        "type": "object",
        "title": "DataQualityContext"
      },
      "DataSource": {
        "type": "string",
        "enum": [
          "SIMULATED",
          "MANUAL_INPUT",
          "TELEMETRY",
          "EXTERNAL_REFERENCE"
        ],
        "title": "DataSource"
      },
      "DeviationSeverity": {
        "type": "string",
        "enum": [
          "INFO",
          "WARNING",
          "CRITICAL",
          "UNKNOWN"
        ],
        "title": "DeviationSeverity"
      },
      "EnvironmentStatus": {
        "properties": {
          "radiation_status": {
            "type": "string",
            "title": "Radiation Status",
            "default": "UNKNOWN"
          },
          "cabin_pressure_status": {
            "type": "string",
            "title": "Cabin Pressure Status",
            "default": "UNKNOWN"
          },
          "co2_status": {
            "type": "string",
            "title": "Co2 Status",
            "default": "UNKNOWN"
          },
          "life_support_status": {
            "type": "string",
            "title": "Life Support Status",
            "default": "UNKNOWN"
          },
          "habitat_status": {
            "type": "string",
            "title": "Habitat Status",
            "default": "UNKNOWN"
          },
