  "components": {
    "schemas": {
      "AnomalyExplanation": {
        "properties": {
          "layer": {
            "type": "string",
            "title": "Layer",
            "description": "Detection layer: SENSOR_LIMITS, DATA_QUALITY, ENGINEERING_PHYSICS, STATISTICAL_ZSCORE, or ML_ISOLATION_FOREST"
          },
          "parameter": {
            "type": "string",
            "title": "Parameter"
          },
          "observed_value": {
            "type": "number",
            "title": "Observed Value"
          },
          "expected_range": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Range"
          },
          "severity": {
            "$ref": "#/components/schemas/DeviationSeverity"
          },
          "confidence_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Score"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "contributing_factors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contributing Factors"
          },
          "is_advisory": {
            "type": "boolean",
            "title": "Is Advisory",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "layer",
          "parameter",
          "observed_value",
          "severity",
          "confidence_score",
          "explanation"
        ],
        "title": "AnomalyExplanation"
      },
      "CommStatus": {
        "type": "string",
        "enum": [
          "OPTIMAL",
          "NOMINAL",
          "DELAYED",
          "INTERMITTENT",
          "DEGRADED",
          "BLACKOUT",
          "UNKNOWN"
        ],
        "title": "CommStatus"
      },
      "CommunicationCharacteristics": {
        "properties": {
          "link_type": {
            "type": "string",
            "title": "Link Type",
            "description": "Link type, e.g. TDRSS or DSN"
          },
          "expected_delay_seconds": {
            "type": "number",
            "minimum": 0.0,
            "title": "Expected Delay Seconds",
            "description": "One-way light-time delay in seconds"
          },
          "bandwidth_mbps": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Bandwidth Mbps",
            "description": "Available bandwidth in megabits per second"
          },
          "reachability": {
            "type": "string",
            "title": "Reachability",
            "description": "Reachability mode"
          }
        },
        "type": "object",
        "required": [
          "link_type",
          "expected_delay_seconds",
          "bandwidth_mbps",
          "reachability"
        ],
        "title": "CommunicationCharacteristics"
      },
      "CommunicationContext": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CommStatus",
            "default": "NOMINAL"
          },
          "expected_delay_seconds": {
            "type": "number",
            "title": "Expected Delay Seconds",
            "default": 1.2
          },
          "bandwidth_mbps": {
            "type": "number",
            "title": "Bandwidth Mbps",
            "default": 50.0
          },
          "earth_reachable": {
            "type": "boolean",
            "title": "Earth Reachable",
            "default": true
          },
          "queued_reports_count": {
            "type": "integer",
            "title": "Queued Reports Count",
            "default": 0
          },
          "last_contact_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Contact Timestamp"
          },
          "last_acknowledged_timestamp": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Acknowledged Timestamp"
          }
        },
        "type": "object",
        "title": "CommunicationContext"
      },
      "ContextTransitionRequest": {
        "properties": {
          "target_state": {
            "$ref": "#/components/schemas/OperationalState"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence"
          },
          "operator_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Operator Id",
