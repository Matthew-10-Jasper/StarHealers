          },
          "anomalies": {
            "items": {
              "$ref": "#/components/schemas/AnomalyExplanation"
            },
            "type": "array",
            "title": "Anomalies"
          },
          "ml_isolation_score": {
            "anyOf": [
              {
                "type": "number"
